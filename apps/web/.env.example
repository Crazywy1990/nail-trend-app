# AllTen web app (apps/web). Copy to .env.local for local dev; set the same names in
# Vercel → Project Settings → Environment Variables. Redeploy after changing API_URL:
# it is read at build time for the /api/v1/* proxy and at request time for page data.

# Optional. By default the web app uses its built-in engine (lib/engine) and needs no API.
# Set USE_REMOTE_API=1 to call the Python service at API_URL instead.
USE_REMOTE_API=0

# Base URL of the FastAPI service (only used when USE_REMOTE_API=1). No trailing slash, no /v1.
# Local:      http://127.0.0.1:8000
# Production: your API's URL, e.g. https://allten-api.vercel.app (Vercel) or https://allten-api.onrender.com (Render)
API_URL=http://127.0.0.1:8000

# Public URL of this web app, used for share links, spec-sheet links and preview images.
# Production: your Vercel URL now, https://allten.app once the domain is connected.
SITE_URL=http://localhost:3000
