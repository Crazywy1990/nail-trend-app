# AllTen API (services/api). Set these in Render → your service → Environment.

# Database. Unset = SQLite file on the instance (fine for a demo; resets on every
# deploy/restart). For persistence use Supabase Postgres, with the psycopg driver prefix:
# postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres
DATABASE_URL=sqlite:///./dev.db

# Comma-separated origins allowed by CORS. The web app proxies API calls server-side,
# so this only matters for direct browser calls.
WEB_ORIGINS=http://localhost:3000
